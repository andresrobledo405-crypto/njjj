# Google Gemini AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Specify Gemini models (defaults used if not set)
GEMINI_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Backend service URL for frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Optional: Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Optional: Logging
LOG_LEVEL=info
LOG_FILE=logs/gemini.log

# Optional: Cache configuration
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Optional: Runway ML API (if integrating video generation)
RUNWAYML_API_SECRET=your_runway_api_key

# Optional: Pika API (if integrating Pika video generation)
PIKA_API_KEY=your_pika_api_key
