# Copie este archivo como .env y ajuste los valores. Nunca suba .env al repositorio.
CLINICAPRO_NOMBRE=Clínica Pro
# CLINICAPRO_DATA_DIR=C:\ClinicaPro\data
# CLINICAPRO_ADMIN_USER=admin
# CLINICAPRO_ADMIN_PASSWORD=   (si se omite, se genera y se guarda en data/admin_inicial.txt)
# CLINICAPRO_SECRET=           (firma de sesiones; si se omite, se genera en data/.secret)
# CLINICAPRO_COOKIE_SECURE=1   (obligatorio al publicar con HTTPS)
