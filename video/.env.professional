# ╔══════════════════════════════════════════════════════════════╗
# ║          PROFESSIONAL VIDEO PRODUCTION CONFIGURATION           ║
# ║                     Maximum Quality Settings                   ║
# ╚══════════════════════════════════════════════════════════════╝

# PYTHON & SYSTEM
HYPERFRAMES_PYTHON=python3
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VIDEO ENCODING - PROFESSIONAL QUALITY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Main encoding
VIDEO_CODEC=libx264
VIDEO_PRESET=slow                    # slow=best quality
VIDEO_CRF=14                         # 14-18 = professional
VIDEO_BITRATE=8000k                  # 8-12 Mbps
VIDEO_PROFILE=high
VIDEO_LEVEL=4.2
VIDEO_PIXEL_FORMAT=yuv420p
VIDEO_MOVFLAGS=+faststart

# Alternative codecs
ALT_CODEC_H265=libx265
ALT_CODEC_VP9=libvpx-vp9

# AUDIO ENCODING
AUDIO_CODEC=aac
AUDIO_BITRATE=192k                   # Professional stereo
AUDIO_SAMPLE_RATE=48000              # Professional sample rate
AUDIO_CHANNELS=2

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VIDEO RESOLUTION & FORMAT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Primary format (TikTok/Shorts/Reels native)
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_ASPECT_RATIO=9:16
VIDEO_FPS=30

# Alternative resolutions
ALT_RESOLUTION_4K=3840x2160
ALT_RESOLUTION_HD=1920x1080
ALT_RESOLUTION_LANDSCAPE=1920x1080

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI MODELS & APIs (Professional Quality)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# PRIMARY: Runway ML (highest quality)
RUNWAYML_API_SECRET=sk_production_your_key_here
RUNWAY_MODEL=gen2-turbo                  # Best quality/speed balance
RUNWAY_QUALITY_LEVEL=high                # high/medium/fast

# SECONDARY: fal.ai (fast, high quality)
FAL_KEY=your_fal_key_here
FAL_MODEL=fal-ai/fast-sdxl               # Fast SDXL
FAL_QUALITY=high

# TERTIARY: LTX Studio (AI enhancement)
LTX_STUDIO_KEY=your_ltx_key_here
LTX_QUALITY=ultra                        # ultra/high/standard

# QUATERNARY: Local HyperFrames (deterministic)
HYPERFRAMES_MODE=local
HYPERFRAMES_QUALITY=maximum

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AUDIO PRODUCTION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# PRIMARY: ElevenLabs (professional voices)
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM  # Professional voice
ELEVENLABS_STABILITY=0.75                # 0.5-1.0
ELEVENLABS_SIMILARITY=0.85               # 0.5-1.0
ELEVENLABS_MODEL=eleven_monolingual_v1   # Professional model

# SECONDARY: Suno AI (music generation)
SUNO_API_KEY=your_suno_key_here
SUNO_STYLE=upbeat,energetic,viral        # Tags
SUNO_DURATION=60                         # seconds

# TERTIARY: Meta MusicGen (local fallback)
MUSICGEN_MODEL=facebook/musicgen-medium   # Best balance
MUSICGEN_TOP_K=250
MUSICGEN_TOP_P=0.0

# QUATERNARY: Local Festival/eSpeak
TTS_ENGINE=festival                       # festival/espeak-ng
TTS_VOICE=default

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# COLOR GRADING & EFFECTS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# PRIMARY: Skyreels API
SKYREELS_API_KEY=your_skyreels_key
SKYREELS_PRESET=vibrant                  # vibrant/cinematic/neon/pastel
SKYREELS_SATURATION=1.3                  # 0.0-2.0
SKYREELS_VIBRANCE=0.5                    # 0.0-1.0
SKYREELS_CONTRAST=1.1                    # 0.5-2.0
SKYREELS_BRIGHTNESS=0.05                 # -0.5 to 0.5

# FFmpeg Filters (local fallback)
FFMPEG_FILTER=eq=saturation=1.3:contrast=1.1:brightness=0.05,vibrance=0.5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AUTOMATION SETTINGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Queue & Processing
MAX_CONCURRENT_JOBS=4                    # Parallel processing
MAX_QUEUE_SIZE=1000                      # Max jobs in queue
MAX_RETRIES=3                            # Retry attempts
QUALITY_THRESHOLD=85                     # Auto-retry if < 85
PROCESSING_TIMEOUT=600                   # seconds per job

# Auto-cleanup
AUTO_CLEANUP_TEMP=true
AUTO_CLEANUP_AGE=7                       # days
AUTO_CLEANUP_SIZE_MB=5000                # Keep under 5GB

# Monitoring
ENABLE_MONITORING=true
LOG_LEVEL=debug                          # debug/info/warn/error
LOG_FORMAT=json
METRICS_INTERVAL=300                     # seconds

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BLENDER RENDERING (Professional 3D)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

BLENDER_ENGINE=cycles                    # cycles/eevee
BLENDER_SAMPLES=256                      # 128-512 = quality
BLENDER_DENOISER=openimagedenoise        # Use AI denoising
BLENDER_GPU=auto                         # auto/cuda/optix/hip
BLENDER_TILE_SIZE=256                    # GPU tile size
BLENDER_MEMORY_LIMIT=2048                # MB per GPU

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PLATFORM-SPECIFIC OPTIMIZATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# YouTube Shorts
YOUTUBE_PRESET=professional               # Quality for YouTube
YOUTUBE_BITRATE=8000k
YOUTUBE_MAX_SIZE_MB=2000

# TikTok (FYP optimization)
TIKTOK_PRESET=tiktok_optimized
TIKTOK_BITRATE=6000k
TIKTOK_TRANSITION_FRAMES=30               # Smooth transitions
TIKTOK_SOUND_LEVEL=-3                     # dB normalization

# Instagram Reels
INSTAGRAM_PRESET=instagram_optimized
INSTAGRAM_BITRATE=6000k
INSTAGRAM_THUMBNAIL_TIME=00:00:02         # Auto-thumb at 2s

# Facebook
FACEBOOK_PRESET=mobile_first
FACEBOOK_BITRATE=5000k
FACEBOOK_ADD_CAPTIONS=true

# Twitter/X
TWITTER_PRESET=vertical_video
TWITTER_BITRATE=4000k

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ADVANCED SETTINGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Performance Tuning
FFMPEG_THREADS=auto                      # Auto-detect CPU cores
ENABLE_HARDWARE_ACCELERATION=true
CACHE_FRAMES=true

# Quality Assurance
AUTO_QA_CHECK=true
MIN_QUALITY_SCORE=80                     # Auto-reject if < 80
QUALITY_METRICS=psnr,ssim,vmaf           # Measurement methods

# Safety & Security
ENABLE_VIRUS_SCAN=false                  # Optional scanning
ENCRYPT_OUTPUTS=false
BACKUP_OUTPUTS=true                      # Keep backups

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EXPERIMENTAL (Beta Features)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Future enhancements
ENABLE_SUPER_RESOLUTION=false             # 4K upscaling
ENABLE_FRAME_INTERPOLATION=false          # 60fps from 30fps
ENABLE_BACKGROUND_REMOVAL=false           # Automatic bg removal
ENABLE_VIRTUAL_CAMERA=false               # Real-time preview

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# END OF CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Copy this to .env to activate:
# cp video/.env.professional video/.env
