ANTHROPIC_API_KEY=sk-ant-...
# Modelo a usar (por defecto claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5
# Clave que la app móvil envía en el header x-app-key (invéntela, larga y aleatoria)
APP_KEY=cambie-esto
PORT=3000
# Twilio (opcional pero recomendado): valida que los webhooks vengan de Twilio
TWILIO_AUTH_TOKEN=
# URL pública HTTPS del servidor, sin barra final (ej. https://mi-app.onrender.com)
PUBLIC_URL=
